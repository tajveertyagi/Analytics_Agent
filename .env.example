OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# SMTP -- only needed to actually send report emails from the review card.
# Leave blank to still draft/preview emails in the UI (Send will report that
# email isn't configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
